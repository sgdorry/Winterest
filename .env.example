# Winterest environment variables
#
# Copy this file to `.env` and fill in values only if you need them.
# Local development (default) does not require any of these to be set.

# --- MongoDB connection (used by data/db_connect.py) ---

# Set to "1" to connect to MongoDB Atlas / cloud. Leave unset or "0" for local.
CLOUD_MONGO=0

# Required when CLOUD_MONGO=1.
MONGO_PASSWD=

# Optional overrides for the cloud cluster.
MONGO_USER_NM=mattiasshularsson_db_user
MONGO_HOST=cluster0.nbhhiox.mongodb.net

# --- Seed script (used by scripts/load_script.py) ---

# Override the Mongo URI used by `make seed`. Defaults to mongodb://localhost:27017.
# MONGO_URI=mongodb://localhost:27017
